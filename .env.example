# Pixel Tech web — copy to `.env` (never commit `.env`)
# Vercel: set the same keys in Project → Settings → Environment Variables

# Spring API origin (no trailing slash, no /api suffix)
# Local Docker / mvnw:
# API_PROXY_TARGET=http://127.0.0.1:8081
# Production (Render):
API_PROXY_TARGET=https://YOUR-SERVICE.onrender.com

# AI features run on the backend — set GEMINI_API_KEY in ../backend/.env / Render, not here.
