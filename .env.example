# Pixel Tech web — copy to `.env` (never commit `.env`)
# Vercel: set the same keys in Project → Settings → Environment Variables

# Spring / Cloud Run API origin (no trailing slash, no /api suffix)
# Local Docker API:
# API_PROXY_TARGET=http://127.0.0.1:8081
# Production:
API_PROXY_TARGET=https://pixel-tech-api-389277809553.asia-southeast1.run.app

# AI features run on the backend — set GEMINI_API_KEY in ../backend/.env, not here.
